# Copy to .env and adjust — see docs/PRE_LAUNCH.md for full setup.
#
# This file is COMMITTED. Never put real credentials here.
#
# Vite inlines every VITE_-prefixed var into the production bundle as a literal
# string, so the browser side holds no secrets: all Alpaca traffic goes through
# the backend proxy (/api/alpaca/...), which injects the APCA-* headers
# server-side from user-secrets.

# Mock mode. `true` (or unset) runs on mock positions, quotes, account data and
# simulated option orders. Set to `false` once the backend has Alpaca keys.
VITE_USE_MOCK=true

# Backend (WheelStrategy.Api): analysis endpoints + the Alpaca proxy.
VITE_API_BASE_URL=http://localhost:5099

# Optional: Alpaca market-data feed passed through to the proxy. Non-secret.
# `iex` (free) or `sip` (paid subscription). Defaults to iex.
# VITE_ALPACA_DATA_FEED=iex

# ─── Server-side credentials — NOT here, and never VITE_-prefixed ────────────
#
# Alpaca (proxy + analysis) and Finnhub (earnings/dividends) are configured via
# .NET user-secrets so they stay out of the repo and out of the bundle:
#
#   cd backend/WheelStrategy.Api
#   dotnet user-secrets set "Alpaca:ApiKeyId"     "<key-id>"
#   dotnet user-secrets set "Alpaca:ApiSecretKey" "<secret>"
#   dotnet user-secrets set "Finnhub:ApiKey"      "<token>"
#
# Non-secret backend settings (base URLs, feed, order caps) live in
# backend/WheelStrategy.Api/appsettings.json.
