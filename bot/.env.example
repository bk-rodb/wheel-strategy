# Backend analysis + Alpaca proxy (no Alpaca keys here)
BOT_API_BASE=http://localhost:5099

# This file is the ONLY source of truth for the bot's governance settings (symbols / level /
# dry-run / paused). The bot self-reports these to the API on every cycle so the desk BOT tab
# can mirror them, but the desk tab is read-only — it cannot override anything here.
BOT_SYMBOLS=NVDA,SPCX,RKLB

# Single-symbol override (back-compat; ignored if BOT_SYMBOLS is set)
# BOT_SYMBOL=NVDA

# Analysis level: safe | regular | risky  (MED = regular)
BOT_LEVEL=regular

# When true, log the intended ticket and skip POST /v2/orders
BOT_DRY_RUN=true

# When true, every symbol is skipped each window (Task Scheduler still fires)
BOT_PAUSED=false

# Optional: override poll cadence while waiting on a working order (ms)
# BOT_POLL_MS=5000

# Reprice-on-timeout for live (non-dry-run) orders: if a working order isn't filled within
# BOT_REPRICE_TIMEOUT_MS, cancel it, recompute the ladder from scratch (fresh analysis + spot),
# and resubmit — up to BOT_REPRICE_MAX_ATTEMPTS times before giving up. Off by default.
# BOT_REPRICE_ENABLED=false
# BOT_REPRICE_TIMEOUT_MS=30000
# BOT_REPRICE_MAX_ATTEMPTS=3
