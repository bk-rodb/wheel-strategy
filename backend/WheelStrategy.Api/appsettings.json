{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=wheel.db"
  },
  "Alpaca": {
    "DataBaseUrl": "https://data.alpaca.markets",
    "TradingBaseUrl": "https://paper-api.alpaca.markets",
    "Feed": "iex"
  },
  "AlpacaProxy": {
    "TimeoutSeconds": 15,
    "MaxOrderQty": 50,
    "MaxLimitPrice": 1000,
    "MaxOrderNotional": 250000,
    "AllowOrderPlacement": true
  },
  "Analysis": {
    "DefaultLookbackDays": 730,
    "DefaultDte": 35,
    "RiskFreeRate": 0.045,
    "SafeProb": 0.15,
    "RegularProb": 0.30,
    "RiskyProb": 0.45,
    "MinSamples": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Finnhub": {
    "BaseUrl": "https://finnhub.io/api/v1"
  }
}
