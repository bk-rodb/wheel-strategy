{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "ConnectionStrings": {
    "Default": "Data Source=wheel.db"
  },
  "Alpaca": {
    "DataBaseUrl": "https://data.alpaca.markets",
    "TradingBaseUrl": "https://paper-api.alpaca.markets",
    "Feed": "iex"
  },
  "AlpacaProxy": {
    "TimeoutSeconds": 15,
    "MaxOrderQty": 50,
    "MaxLimitPrice": 1000,
    "MaxOrderNotional": 250000,
    "AllowOrderPlacement": true
  },
  "Analysis": {
    "DefaultLookbackDays": 730,
    "DefaultDte": 35,
    "MaxLookbackDays": 3650,
    "MaxDte": 730,
    "RiskFreeRate": 0.045,
    "SafeDelta": 0.20,
    "RegularDelta": 0.30,
    "RiskyDelta": 0.40,
    "SafeAtrMultiple": 1.5,
    "RegularAtrMultiple": 1.0,
    "RiskyAtrMultiple": 0.7,
    "HmmBearDeltaAdjust": -0.05,
    "HmmBullPutDeltaAdjust": 0.05,
    "HmmBullCallDeltaAdjust": -0.05,
    "MinSamples": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Finnhub": {
    "BaseUrl": "https://finnhub.io/api/v1"
  }
}
